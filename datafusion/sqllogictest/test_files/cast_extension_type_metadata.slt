# Regression tests for logical CAST targets that carry explicit field metadata.

query ?T
SELECT
    CAST(
        arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)')
        AS UUID
    ),
    arrow_metadata(
        CAST(
            arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)')
            AS UUID
        ),
        'ARROW:extension:name'
    );
----
00010203040506070809000102030506 arrow.uuid

query ?T
SELECT
    CAST(raw AS UUID),
    arrow_metadata(CAST(raw AS UUID), 'ARROW:extension:name')
FROM (
    VALUES (
        arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)')
    )
) AS uuids(raw);
----
00010203040506070809000102030506 arrow.uuid

# TRY_CAST to extension type should also preserve extension metadata
query ?T
SELECT
    TRY_CAST(
        arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)')
        AS UUID
    ),
    arrow_metadata(
        TRY_CAST(
            arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)')
            AS UUID
        ),
        'ARROW:extension:name'
    );
----
00010203040506070809000102030506 arrow.uuid

# TRY_CAST to UUID from a subquery
query ?T
SELECT
    TRY_CAST(raw AS UUID),
    arrow_metadata(TRY_CAST(raw AS UUID), 'ARROW:extension:name')
FROM (
    VALUES (
        arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)')
    )
) AS uuids(raw);
----
00010203040506070809000102030506 arrow.uuid

# arrow_cast from UUID to same underlying type (FixedSizeBinary(16)) strips
# extension metadata (type-only cast semantics)
query ?T
SELECT
    arrow_cast(uuid_val, 'FixedSizeBinary(16)'),
    arrow_metadata(arrow_cast(uuid_val, 'FixedSizeBinary(16)'), 'ARROW:extension:name')
FROM (
    SELECT CAST(arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)') AS UUID) AS uuid_val
);
----
00010203040506070809000102030506 NULL

# arrow_cast to a different type strips extension metadata (type-only cast semantics)
query ?T
SELECT
    arrow_cast(uuid_val, 'Binary'),
    arrow_metadata(arrow_cast(uuid_val, 'Binary'), 'ARROW:extension:name')
FROM (
    SELECT CAST(arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)') AS UUID) AS uuid_val
);
----
00010203040506070809000102030506 NULL

##########
## Regression tests for https://github.com/apache/datafusion/issues/24721
##
## Extension metadata is introduced by a projection (the CAST), not by the
## source, so these exercise metadata surviving the physical projection
## optimizations: projection removal, projection collapsing, and swapping a
## projection with its child.
##########

statement ok
CREATE TABLE uuid_src AS
SELECT arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)') AS raw;

# metadata survives an identity re-select above the projection that added it
query T
SELECT arrow_metadata(u, 'ARROW:extension:name') FROM (
  SELECT u FROM (SELECT CAST(raw AS UUID) AS u FROM uuid_src)
);
----
arrow.uuid

# ... and two levels of identity re-select
query T
SELECT arrow_metadata(u, 'ARROW:extension:name') FROM (
  SELECT u FROM (SELECT u FROM (SELECT CAST(raw AS UUID) AS u FROM uuid_src))
);
----
arrow.uuid

# metadata survives a sort between the projection and the reader
query T
SELECT arrow_metadata(u, 'ARROW:extension:name') FROM (
  SELECT CAST(raw AS UUID) AS u FROM uuid_src ORDER BY raw
);
----
arrow.uuid

# metadata survives a limit
query T
SELECT arrow_metadata(u, 'ARROW:extension:name') FROM (
  SELECT CAST(raw AS UUID) AS u FROM uuid_src LIMIT 1
);
----
arrow.uuid

# metadata survives a filter
query T
SELECT arrow_metadata(u, 'ARROW:extension:name') FROM (
  SELECT CAST(raw AS UUID) AS u FROM uuid_src
) WHERE u IS NOT NULL;
----
arrow.uuid

# metadata survives a union
query T rowsort
SELECT arrow_metadata(u, 'ARROW:extension:name') FROM (
  SELECT CAST(raw AS UUID) AS u FROM uuid_src
  UNION ALL
  SELECT CAST(raw AS UUID) AS u FROM uuid_src
);
----
arrow.uuid
arrow.uuid

# metadata survives a join
query T
SELECT arrow_metadata(a.u, 'ARROW:extension:name') FROM
  (SELECT CAST(raw AS UUID) AS u FROM uuid_src) a
  JOIN (SELECT raw FROM uuid_src) b ON a.u = CAST(b.raw AS UUID);
----
arrow.uuid

statement ok
DROP TABLE uuid_src;
